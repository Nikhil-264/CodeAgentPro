# LLM Provider API Keys
GROQ_API_KEY=
GEMINI_API_KEY=

# Ollama local URL (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Execution sandbox
# Code runs in Docker by default. If Docker is unavailable and you accept
# running generated code directly on this machine (NOT isolated — local dev
# only), set this to true. Otherwise the pipeline aborts with a clear error.
ALLOW_LOCAL_SANDBOX=false
